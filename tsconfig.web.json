{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "noEmit": true, "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["web/**/*.ts", "web/**/*.tsx"]
}
