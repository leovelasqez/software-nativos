{
  "customer": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "document": {
        "type": "string",
        "minLength": 3,
        "maxLength": 40
      },
      "phone": {
        "type": "string",
        "minLength": 5,
        "maxLength": 30
      },
      "email": {
        "type": "string",
        "maxLength": 150
      },
      "address": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [
      "id",
      "name",
      "document",
      "phone",
      "email",
      "address"
    ]
  },
  "create": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "document": {
        "type": "string",
        "minLength": 3,
        "maxLength": 40
      },
      "phone": {
        "type": "string",
        "minLength": 5,
        "maxLength": 30
      },
      "email": {
        "type": "string",
        "maxLength": 150
      },
      "address": {
        "type": "string",
        "maxLength": 500
      },
      "branchId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[0-9a-f-]{36}$"
      }
    },
    "required": [
      "name",
      "document",
      "phone",
      "email",
      "address",
      "branchId",
      "operationId"
    ]
  }
}
