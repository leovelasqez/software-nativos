{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nativos:offline-grant-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "grantId",
    "actorId",
    "deviceId",
    "branchId",
    "validatedAtMs",
    "expiresAtMs",
    "actions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "grantId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "actorId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "branchId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "validatedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "data.read",
          "order.write",
          "sale.discount",
          "sale.cancel",
          "sale.charge",
          "shift.open",
          "shift.close",
          "product.create",
          "recipe.create",
          "customer.create",
          "loyalty.enroll",
          "loyalty.redeem",
          "purchase.read",
          "purchase.write",
          "inventory.manage",
          "sale.refund",
          "cash.movement",
          "cost.read",
          "cost.write",
          "loyalty.adjust",
          "settings.manage"
        ]
      }
    }
  }
}
