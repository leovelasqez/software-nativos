{
  "openapi": "3.1.0",
  "info": { "title": "Nativos — API de agentes", "version": "1.0.0", "description": "Frontera online revocable para agentes. No expone SQL, costos ni secretos." },
  "security": [{ "agentBearer": [] }],
  "components": {
    "securitySchemes": { "agentBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque-agent-token" }, "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "nativos_session" } },
    "schemas": {
      "Error": { "type": "object", "additionalProperties": false, "properties": { "code": { "type": "string" }, "message": { "type": "string" } }, "required": ["code", "message"] },
      "Id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" },
      "Page": { "type": "object", "additionalProperties": false, "properties": { "items": { "type": "array", "items": { "type": "object" } }, "nextCursor": { "type": ["string", "null"] } }, "required": ["items", "nextCursor"] },
      "RowError": { "type": "object", "additionalProperties": false, "properties": { "row": { "type": "integer", "minimum": 0 }, "field": { "type": "string" }, "code": { "type": "string" }, "message": { "type": "string" } }, "required": ["row", "field", "code", "message"] },
      "McpRequest": { "type": "object", "additionalProperties": false, "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": ["string", "number", "null"] }, "method": { "enum": ["initialize", "tools/list", "tools/call"] }, "params": { "type": "object" } }, "required": ["jsonrpc", "method"] }
    },
    "responses": { "Unauthorized": { "description": "Token ausente, inválido o revocado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "Forbidden": { "description": "Acción o sucursal no autorizada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "Conflict": { "description": "Operación o vista previa incompatible", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }, "Invalid": { "description": "Entrada o filas inválidas", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } }
  },
  "paths": {
    "/api/agents": { "post": { "operationId": "createAgent", "security": [{ "sessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 2, "maxLength": 100 }, "branchIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/Id" } }, "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "reason": { "type": "string", "minLength": 3, "maxLength": 500 } }, "required": ["name", "branchIds", "actions", "reason"] } } } }, "responses": { "201": { "description": "Agente y token revelado una sola vez", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "$ref": "#/components/schemas/Id" }, "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" } }, "required": ["id", "token"] } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/agents/{id}": { "patch": { "operationId": "setAgentActive", "security": [{ "sessionCookie": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "active": { "type": "boolean" }, "reason": { "type": "string", "minLength": 3, "maxLength": 500 } }, "required": ["active", "reason"] } } } }, "responses": { "200": { "description": "Credencial activada o revocada", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/agents/{id}/rotate": { "post": { "operationId": "rotateAgentToken", "security": [{ "sessionCookie": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500 } }, "required": ["reason"] } } } }, "responses": { "200": { "description": "Token nuevo revelado una sola vez", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "$ref": "#/components/schemas/Id" }, "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" } }, "required": ["id", "token"] } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/agent/v1/me": { "get": { "operationId": "agentMe", "responses": { "200": { "description": "Principal agente", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "id": { "$ref": "#/components/schemas/Id" }, "name": { "type": "string" }, "branchIds": { "type": "array", "items": { "$ref": "#/components/schemas/Id" } }, "actions": { "type": "array", "items": { "type": "string" } } }, "required": ["id", "name", "branchIds", "actions"] } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/agent/v1/products": { "get": { "operationId": "agentProducts", "parameters": [{ "name": "branchId", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }, { "name": "after", "in": "query", "schema": { "$ref": "#/components/schemas/Id" } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }, { "name": "q", "in": "query", "schema": { "type": "string", "maxLength": 100 } }], "responses": { "200": { "description": "Productos sin costos", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Page" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/agent/v1/recipes": { "get": { "operationId": "agentRecipes", "parameters": [{ "name": "branchId", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }, { "name": "after", "in": "query", "schema": { "$ref": "#/components/schemas/Id" } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }], "responses": { "200": { "description": "Recetas activas", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Page" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/agent/v1/inventory": { "get": { "operationId": "agentInventory", "parameters": [{ "name": "branchId", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }, { "name": "after", "in": "query", "schema": { "type": "string" } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }], "responses": { "200": { "description": "Existencias y mínimos sin costos", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Page" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/agent/v1/movements": { "get": { "operationId": "agentMovements", "parameters": [{ "name": "branchId", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }, { "name": "after", "in": "query", "schema": { "$ref": "#/components/schemas/Id" } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }], "responses": { "200": { "description": "Movimientos sin entrada ni costo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Page" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/agent/v1/reports/{kind}": { "get": { "operationId": "agentReport", "parameters": [{ "name": "kind", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "branchId", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }], "responses": { "200": { "description": "Informe y contexto de sincronización", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/agent/v1/imports/preview": { "post": { "operationId": "agentInventoryImportPreview", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "agent-import-v1.schema.json#/$defs/inventoryPreview" } } } }, "responses": { "200": { "description": "Errores por fila o fingerprint", "content": { "application/json": { "schema": { "type": "object", "properties": { "valid": { "type": "boolean" }, "errors": { "type": "array", "items": { "$ref": "#/components/schemas/RowError" } }, "previewFingerprint": { "type": "string" } }, "required": ["valid", "errors"] } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/Invalid" } } } },
    "/api/agent/v1/imports/confirm": { "post": { "operationId": "agentInventoryImportConfirm", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "agent-import-v1.schema.json#/$defs/inventoryPreview" } } } }, "responses": { "200": { "description": "Resultado idempotente", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/Invalid" } } } },
    "/api/agent/v1/imports/catalog/preview": { "post": { "operationId": "agentCatalogImportPreview", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "agent-import-v1.schema.json#/$defs/catalogPreview" } } } }, "responses": { "200": { "description": "Errores por fila o fingerprint", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/Invalid" } } } },
    "/api/agent/v1/imports/catalog/confirm": { "post": { "operationId": "agentCatalogImportConfirm", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "agent-import-v1.schema.json#/$defs/catalogPreview" } } } }, "responses": { "200": { "description": "Productos y recetas creados de forma atómica", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/Invalid" } } } },
    "/api/agent/v1/mcp": { "post": { "operationId": "agentMcp", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/McpRequest" } } } }, "responses": { "200": { "description": "Respuesta JSON-RPC MCP", "content": { "application/json": { "schema": { "type": "object" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } } }
  }
}
