{
  "draft": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "revision": {
        "type": "integer",
        "minimum": 0
      },
      "snapshotId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "lines": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
            },
            "productId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
            },
            "quantity": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,6})?$"
            },
            "optionIds": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
              }
            },
            "snapshotId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
            }
          },
          "required": [
            "id",
            "productId",
            "quantity",
            "optionIds",
            "snapshotId"
          ]
        }
      }
    },
    "required": [
      "id",
      "revision",
      "snapshotId",
      "lines"
    ]
  },
  "payment": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "method": {
        "enum": [
          "cash",
          "card",
          "transfer",
          "breb",
          "daviplata",
          "nequi"
        ]
      },
      "received": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,6})?$"
      }
    },
    "required": [
      "method",
      "received"
    ]
  },
  "line": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "productId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "quantity": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,6})?$"
      },
      "optionIds": {
        "type": "array",
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        }
      },
      "snapshotId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      }
    },
    "required": [
      "id",
      "productId",
      "quantity",
      "optionIds",
      "snapshotId"
    ]
  }
}
