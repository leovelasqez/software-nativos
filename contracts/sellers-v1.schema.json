{
  "create": {
    "type": "object", "additionalProperties": false,
    "required": ["operationId", "name", "active", "branchIds", "reason"],
    "properties": {
      "operationId": {"type":"string", "pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
      "name": {"type":"string", "minLength":2, "maxLength":100, "pattern":"\\S"},
      "active": {"type":"boolean"},
      "branchIds": {"type":"array", "minItems":1, "maxItems":100, "uniqueItems":true, "items":{"type":"string", "pattern":"^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"}},
      "reason": {"type":"string", "minLength":3, "maxLength":500, "pattern":"\\S"}
    }
  }
}
