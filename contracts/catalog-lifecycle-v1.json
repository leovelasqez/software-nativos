{
  "openapi": "3.1.0",
  "info": { "title": "Nativos — Ciclo de vida de catálogo", "version": "1.0.0" },
  "paths": {
    "/api/products/archived": { "get": { "operationId": "get__api_products_archived", "security": [{ "sessionCookie": [] }], "parameters": [{ "in": "query", "name": "branchId", "required": true, "schema": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" } }, { "in": "query", "name": "after", "required": false, "schema": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" } }, { "in": "query", "name": "limit", "required": false, "schema": { "type": "string", "pattern": "^([1-9][0-9]?|100)$" } }], "responses": { "200": { "description": "Productos archivados", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "items": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "reference": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "archivedAt": { "type": "string", "format": "date-time" } }, "required": ["id", "name", "reference", "version", "archivedAt"] } }, "nextCursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }, "required": ["items", "nextCursor"] } } } }, "400": { "$ref": "#/components/responses/error" }, "401": { "$ref": "#/components/responses/error" }, "403": { "$ref": "#/components/responses/error" } } } },
    "/api/products/{id}/archive": { "post": { "operationId": "post__api_products_id_archive", "security": [{ "sessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" } }, { "in": "header", "name": "X-Nativos-Request", "required": true, "schema": { "const": "1" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/transition" } } } }, "responses": { "200": { "description": "Archivado", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string" }, "archived": { "const": true } }, "required": ["id", "archived"] } } } }, "400": { "$ref": "#/components/responses/error" }, "401": { "$ref": "#/components/responses/error" }, "403": { "$ref": "#/components/responses/error" }, "404": { "$ref": "#/components/responses/error" }, "409": { "$ref": "#/components/responses/error" } } } },
    "/api/products/{id}/restore": { "post": { "operationId": "post__api_products_id_restore", "security": [{ "sessionCookie": [] }], "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" } }, { "in": "header", "name": "X-Nativos-Request", "required": true, "schema": { "const": "1" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/transition" } } } }, "responses": { "200": { "description": "Restaurado", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string" }, "archived": { "const": false } }, "required": ["id", "archived"] } } } }, "400": { "$ref": "#/components/responses/error" }, "401": { "$ref": "#/components/responses/error" }, "403": { "$ref": "#/components/responses/error" }, "404": { "$ref": "#/components/responses/error" }, "409": { "$ref": "#/components/responses/error" } } } }
  },
  "components": {
    "schemas": { "transition": { "type": "object", "additionalProperties": false, "properties": { "branchId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" }, "operationId": { "type": "string", "format": "uuid" }, "reason": { "type": "string", "minLength": 3, "maxLength": 2000, "pattern": ".*\\S.*" }, "expectedVersion": { "type": "integer", "minimum": 1 } }, "required": ["branchId", "operationId", "reason", "expectedVersion"] }, "archivedProduct": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "reference": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "archivedAt": { "type": "string", "format": "date-time" } }, "required": ["id", "name", "reference", "version", "archivedAt"] } },
    "responses": { "error": { "description": "Error", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": { "code": { "type": "string" }, "message": { "type": "string" } }, "required": ["code", "message"] } } } } }
  }
}
