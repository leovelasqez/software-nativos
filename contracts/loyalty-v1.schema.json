{
  "rule": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "earnEvery": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,8})$"
      },
      "pointValue": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,8})$"
      },
      "maxPercent": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,8})$"
      },
      "createdAtMs": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "id",
      "earnEvery",
      "pointValue",
      "maxPercent",
      "createdAtMs"
    ]
  },
  "enroll": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "branchId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "customerId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      }
    },
    "required": [
      "branchId",
      "operationId",
      "customerId"
    ]
  },
  "adjust": {
    "type": "object",
