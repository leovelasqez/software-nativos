        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "customerId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "delta": {
        "type": "string",
        "pattern": "^-?(0|[1-9][0-9]{0,11})$"
      },
      "reason": {
        "type": "string",
        "minLength": 3,
        "maxLength": 500
      }
    },
    "required": [
      "branchId",
      "operationId",
      "customerId",
      "delta",
      "reason"
    ]
  },
  "rules": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "branchId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
