{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nativos/agent-import-v1",
  "title": "Nativos agent import v1",
  "oneOf": [
    { "$ref": "#/$defs/inventoryPreview" },
    { "$ref": "#/$defs/catalogPreview" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$" },
    "operationId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$" },
    "reason": { "type": "string", "minLength": 3, "maxLength": 500 },
    "inventoryRow": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["initial", "entry", "adjustment_in", "adjustment_out"] },
        "itemId": { "$ref": "#/$defs/id" },
        "warehouseId": { "$ref": "#/$defs/id" },
        "quantity": { "$ref": "#/$defs/decimal" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "reason": { "$ref": "#/$defs/reason" }
      },
      "required": ["row", "kind", "itemId", "warehouseId", "quantity", "unit", "reason"]
    },
    "inventoryPreview": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": { "const": "inventory" },
        "operationId": { "$ref": "#/$defs/operationId" },
        "branchId": { "$ref": "#/$defs/id" },
        "reason": { "$ref": "#/$defs/reason" },
        "previewFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rows": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/inventoryRow" } }
      },
      "required": ["kind", "operationId", "branchId", "reason", "rows"]
    },
    "catalogPreview": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": { "const": "catalog" },
        "operationId": { "$ref": "#/$defs/operationId" },
        "branchId": { "$ref": "#/$defs/id" },
        "reason": { "$ref": "#/$defs/reason" },
        "previewFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rows": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/catalogRow" } }
      },
      "required": ["kind", "operationId", "branchId", "reason", "rows"]
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 160 }, "reference": { "type": "string", "minLength": 2, "maxLength": 100 },
        "category": { "type": "string", "minLength": 2, "maxLength": 100 }, "presentation": { "type": "string", "minLength": 2, "maxLength": 160 },
        "type": { "enum": ["finished", "prepared"] }, "price": { "$ref": "#/$defs/decimal" }, "description": { "type": "string", "maxLength": 1000 },
        "tax": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "properties": { "label": { "type": "string", "minLength": 2, "maxLength": 80 }, "rate": { "$ref": "#/$defs/decimal" }, "exempt": { "type": "boolean" } }, "required": ["label", "rate", "exempt"] }] }
      },
      "required": ["name", "reference", "category", "presentation", "type", "price", "tax", "description"]
    },
    "recipeLine": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "itemId": { "$ref": "#/$defs/id" }, "quantity": { "$ref": "#/$defs/decimal" }, "unit": { "type": "string", "minLength": 1, "maxLength": 20 }, "conversion": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "properties": { "factor": { "$ref": "#/$defs/decimal" }, "source": { "type": "string", "minLength": 2, "maxLength": 160 } }, "required": ["factor", "source"] }] }, "kind": { "enum": ["ingredient", "packaging"] } },
      "required": ["id", "itemId", "quantity", "unit", "conversion", "kind"]
    },
    "recipe": {
      "type": "object", "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 2, "maxLength": 160 }, "instructions": { "type": "string", "maxLength": 4000 }, "lines": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/recipeLine" } }, "options": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 2, "maxLength": 160 }, "kind": { "enum": ["addition", "substitution"] }, "replacesLineId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }, "price": { "$ref": "#/$defs/decimal" }, "line": { "$ref": "#/$defs/recipeLine" } }, "required": ["id", "name", "kind", "replacesLineId", "price", "line"] } } },
      "required": ["name", "instructions", "lines", "options"]
    },
    "catalogRow": {
      "type": "object", "additionalProperties": false,
      "properties": { "row": { "type": "integer", "minimum": 1 }, "product": { "$ref": "#/$defs/product" }, "recipe": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/recipe" }] } },
      "required": ["row", "product", "recipe"]
    }
  }
}
