{
  "name": "nativos",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "check": "npm run typecheck && npm test && npm run test:integration && npm run build",
    "build": "vite build",
    "dev": "npm run build && node scripts/dev.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "ajv": "8.20.0",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
